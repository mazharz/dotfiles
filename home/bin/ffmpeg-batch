#!/usr/bin/env bash

# usage:
# $ ffmpeg-batch webm-to-opus *.webm
# $ ffmpeg-batch flac-to-opus *.flac

convertion="$1"
files=("${@:2}")

if [[ "$convertion" == "webm-to-opus" ]];then
  for ((i=0; i < ${#files[@]}; i++)); do
    ffmpeg -i "${files[$i]}" -c:a copy -vn "${files[$i]%.webm}.opus"
  done
elif [[ "$convertion" == "flac-to-opus" ]];then
  for ((i=0; i < ${#files[@]}; i++));do
    ffmpeg -i "${files[$i]}" -map 0:a:0 -c:a libopus -b:a 160k "${files[$i]%.flac}.opus"
  done
fi
